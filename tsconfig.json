{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@nexus/schema": ["./packages/schema/src/index.ts"],
      "@nexus/markdown": ["./packages/markdown/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "server/src/**/*.ts", "apps/web/src/**/*.ts", "apps/web/src/**/*.tsx", "apps/desktop/src/**/*.ts", "tests/**/*.ts", "*.config.ts"]
}
